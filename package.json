{
  "name": "dsh-screen-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Screen capture from the DSH session header: select an area, a window, or the full screen, then annotate/edit (shapes, arrows, text, mosaic), copy, or save through a native save dialog.",
  "exports": {
    ".": "./server.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "server.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
